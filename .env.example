# Copier vers .env a la racine du depot (.env est gitignore).
# Aucune valeur reelle ici — ce fichier-ci est commite.
#
# Cle The Odds API (cotes bet365/DraftKings). Obligatoire pour signal.py.
ODDS_API_KEY=
# Optionnel: section "Analyse experte IA" du dashboard (ai_analyst.py).
ANTHROPIC_API_KEY=

# ── Reglages The Odds API (odds_api.py) — tous optionnels ───────────────────
# Le plan gratuit donne 500 credits par MOIS. Sur l'endpoint des props joueurs
# un appel coute 10 credits par (marche x region): sans plafond, un cron
# horaire epuise le quota en quelques heures.
#
# Regions demandees. Pinnacle (le book le plus efficient, utilise comme
# baseline no-vig) n'existe que dans la region eu.
ODDS_REGIONS=us,eu
# Duree du cache disque des reponses, en secondes.
ODDS_CACHE_TTL=1800
# Credits gardes en reserve: sous ce seuil, les appels sont refuses plutot que
# de renvoyer une erreur traduite en cote 0.
ODDS_QUOTA_RESERVE=40
# Nombre maximal de matchs pour lesquels on demande des props par execution.
ODDS_MAX_PROP_EVENTS=6
# Mettre a 0 pour couper completement les appels props (mode economie).
ODDS_PROPS_ENABLED=1
